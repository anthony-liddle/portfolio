# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Lately: Watching ---------------------------------------------------
# TMDB API Read Access Token (v4 auth), used to look up film directors.
TMDB_READ_ACCESS_TOKEN=

# --- Lately: Listening --------------------------------------------------
# Apple Music developer token credentials. The token is an ES256 JWT signed at
# build time from these three; there is no user sign-in involved.
#
# Key ID: 10 characters, shown next to the key in the Apple developer portal.
APPLE_MUSIC_KEY_ID=
# Team ID: 10 characters, from the membership details on your account page.
APPLE_MUSIC_TEAM_ID=
# The downloaded .p8 private key file, base64 encoded as a single line:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APPLE_MUSIC_PRIVATE_KEY_BASE64=

# Discogs personal access token, from Settings > Developers. Used as the
# fallback when Apple Music has no match, and for pressing-level lookups.
DISCOGS_USER_TOKEN=
